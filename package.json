{
  "name": "azelvori-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "workspaces": [
    "apps/web",
    "packages/contracts",
    "services/api",
    "infrastructure/cdk"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 0.0.0.0 --port 4173",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && node scripts/build-api.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "infra:synth": "npm run build:api && cdk synth --app 'node --import tsx infrastructure/cdk/app.ts' --output cdk.out",
    "build:api": "node scripts/build-api.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1156.0",
    "@aws-sdk/lib-dynamodb": "3.1156.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.56.1",
    "@types/aws-lambda": "^8.10.159",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "aws-cdk": "^2.1033.0",
    "aws-cdk-lib": "2.274.0",
    "constructs": "^10.4.2",
    "esbuild": "0.28.1",
    "prettier": "3.9.10",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
