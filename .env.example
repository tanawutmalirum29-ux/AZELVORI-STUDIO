# Copy to apps/web/.env.local. All VITE_ values are PUBLIC identifiers, never secrets.
# With these unset, the website runs a clearly labeled preview; no lead is sent.
VITE_API_BASE_URL=
VITE_PUBLIC_INTAKE_ENABLED=false
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_SITE_URL=
